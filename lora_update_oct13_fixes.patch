diff --git a/src/lora/voice/tts/external.py b/src/lora/voice/tts/external.py
new file mode 100644
index 0000000..b911ad1
--- /dev/null
+++ b/src/lora/voice/tts/external.py
@@ -0,0 +1,148 @@
+"""Client for the standalone voice server (see server_main.py)."""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import queue
+import subprocess
+import sys
+import threading
+import wave
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+logger = logging.getLogger(__name__)
+SERVER_SCRIPT = Path(__file__).with_name("server_main.py")
+
+
+def find_tts_python() -> str | None:
+    """Python of the separate voice environment: LORA_TTS_PYTHON, else <project>/.venv-tts."""
+    env = os.environ.get("LORA_TTS_PYTHON")
+    if env and Path(env).exists():
+        return env
+    for base in list(Path(__file__).resolve().parents)[:8]:
+        for rel in (Path(".venv-tts") / "Scripts" / "python.exe", Path(".venv-tts") / "bin" / "python"):
+            if (base / rel).exists():
+                return str(base / rel)
+    return None
+
+
+class ExternalVoiceServer:
+    def __init__(self, python_exe: str, models_dir: str, script: Path = SERVER_SCRIPT, env: dict[str, str] | None = None) -> None:
+        self.python_exe, self.models_dir, self.script = python_exe, models_dir, script
+        self.env = {**os.environ, **(env or {})}
+        self.state = "unstarted"  # unstarted | ready | failed
+        self.reason, self.fix, self.dir, self.sample_rate = "", "", "", 0
+        self._proc: subprocess.Popen | None = None
+        self._lines: queue.Queue[dict[str, Any]] = queue.Queue()
+        self._lock = threading.Lock()
+        self._next_id = 0
+
+    # ------------------------------------------------------------------ lifecycle
+    def start(self, timeout: float = 300.0) -> bool:
+        if self.state in ("ready", "failed"):
+            return self.state == "ready"
+        flags = getattr(subprocess, "CREATE_NO_WINDOW", 0) if sys.platform == "win32" else 0
+        try:
+            self._proc = subprocess.Popen(
+                [self.python_exe, str(self.script), "--models-dir", self.models_dir],
+                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                text=True, encoding="utf-8", bufsize=1, env=self.env, creationflags=flags,
+            )
+        except Exception as exc:
+            return self._fail(f"could not start the voice environment ({exc})", r"run scripts\install_tts.ps1")
+        threading.Thread(target=self._read_stdout, daemon=True).start()
+        threading.Thread(target=self._drain_stderr, daemon=True).start()
+        try:
+            msg = self._lines.get(timeout=timeout)
+        except queue.Empty:
+            return self._fail("the voice environment took too long to load", "check the terminal for errors")
+        if msg.get("event") == "ready":
+            self.state, self.dir, self.sample_rate = "ready", str(msg.get("dir", "")), int(msg.get("sr", 24000))
+            logger.info("Qwen3-TTS voice server ready (%s).", self.dir)
+            return True
+        return self._fail(str(msg.get("reason", "unknown error")), str(msg.get("fix", "")))
+
+    def _fail(self, reason: str, fix: str) -> bool:
+        self.state, self.reason, self.fix = "failed", reason, fix
+        logger.warning("Qwen3-TTS voice server unavailable: %s. Fix: %s", reason, fix or "see the terminal")
+        self.stop()
+        return False
+
+    def _read_stdout(self) -> None:
+        assert self._proc and self._proc.stdout
+        for line in self._proc.stdout:
+            try:
+                self._lines.put(json.loads(line))
+            except Exception:
+                logger.info("tts-server: %s", line.strip())
+        self._lines.put({"event": "closed"})
+
+    def _drain_stderr(self) -> None:
+        assert self._proc and self._proc.stderr
+        for line in self._proc.stderr:
+            if line.strip():
+                logger.debug("tts-server: %s", line.strip())
+
+    def stop(self) -> None:
+        proc, self._proc = self._proc, None
+        if proc and proc.poll() is None:
+            try:
+                proc.stdin.write(json.dumps({"cmd": "quit"}) + "\n")
+                proc.stdin.flush()
+                proc.wait(timeout=3)
+            except Exception:
+                proc.kill()
+
+    @property
+    def alive(self) -> bool:
+        return self._proc is not None and self._proc.poll() is None
+
+    # ------------------------------------------------------------------ synthesis
+    def synthesize(self, text: str, voice: str = "vivian", timeout: float = 120.0) -> tuple[np.ndarray, int] | None:
+        if self.state != "ready" or not self.alive:
+            return None
+        with self._lock:
+            self._next_id += 1
+            rid = self._next_id
+            try:
+                self._proc.stdin.write(json.dumps({"id": rid, "text": text, "voice": voice}) + "\n")  # type: ignore[union-attr]
+                self._proc.stdin.flush()  # type: ignore[union-attr]
+            except Exception as exc:
+                self._fail(f"lost the voice process ({exc})", "restart LORA")
+                return None
+            while True:
+                try:
+                    msg = self._lines.get(timeout=timeout)
+                except queue.Empty:
+                    logger.warning("Voice server timed out on %r", text[:40])
+                    return None
+                if msg.get("event") == "closed":
+                    self._fail("the voice process exited", "restart LORA")
+                    return None
+                if msg.get("id") != rid:
+                    continue
+                if not msg.get("ok"):
+                    logger.warning("Voice server could not speak: %s", msg.get("error"))
+                    return None
+                return self._load(str(msg["path"]), int(msg.get("sr", self.sample_rate)))
+
+    @staticmethod
+    def _load(path: str, sr: int) -> tuple[np.ndarray, int] | None:
+        try:
+            with wave.open(path, "rb") as w:
+                raw = w.readframes(w.getnframes())
+                sr = w.getframerate() or sr
+            return np.frombuffer(raw, dtype="<i2").astype(np.float32) / 32768.0, sr
+        except Exception as exc:
+            logger.warning("Could not read the voice audio: %s", exc)
+            return None
+        finally:
+            try:
+                os.remove(path)
+            except OSError:
+                pass
diff --git a/src/lora/voice/tts/server_main.py b/src/lora/voice/tts/server_main.py
new file mode 100644
index 0000000..f2265d6
--- /dev/null
+++ b/src/lora/voice/tts/server_main.py
@@ -0,0 +1,175 @@
+"""Standalone Qwen3-TTS voice server. Runs in its OWN Python environment (.venv-tts) with GPU PyTorch.
+
+LORA's main environment (managed by uv) ships the CPU build of PyTorch and `uv run` would undo any GPU build
+installed there, so the natural voice lives in a separate environment and is driven over stdin/stdout.
+
+Protocol (one JSON object per line):
+  server -> {"event": "ready", "dir": "...", "sr": 24000}  or  {"event": "error", "reason": "...", "fix": "..."}
+  client -> {"id": 1, "text": "Hello.", "voice": "vivian"}
+  server -> {"id": 1, "ok": true, "path": "C:/.../lora_tts_x.wav", "sr": 24000}  (16-bit mono WAV; client deletes it)
+  client -> {"cmd": "quit"}
+This file imports nothing from `lora` on purpose. LORA_TTS_FAKE=1 swaps the model for a test tone (used by tests).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+import struct
+import sys
+import tempfile
+import wave
+from pathlib import Path
+
+SMALL_MODEL_NAME = "Qwen3-TTS-12Hz-0.6B-CustomVoice"
+FAKE_SR = 22050
+
+
+def emit(obj: dict) -> None:
+    sys.stdout.write(json.dumps(obj) + "\n")
+    sys.stdout.flush()
+
+
+def write_wav(samples: list[float], sr: int) -> str:
+    fd, path = tempfile.mkstemp(suffix=".wav", prefix="lora_tts_")
+    os.close(fd)
+    frames = b"".join(struct.pack("<h", int(max(-1.0, min(1.0, s)) * 32767)) for s in samples)
+    with wave.open(path, "wb") as w:
+        w.setnchannels(1)
+        w.setsampwidth(2)
+        w.setframerate(sr)
+        w.writeframes(frames)
+    return path
+
+
+def has_weights(p: Path) -> bool:
+    return p.is_dir() and ((p / "model.safetensors").exists() or (p / "model.safetensors.index.json").exists() or any(p.glob("model-*.safetensors")))
+
+
+def weights_gb(p: Path) -> float:
+    return sum(f.stat().st_size for f in p.glob("*.safetensors")) / 1e9
+
+
+def need_gb(p: Path) -> float:
+    return weights_gb(p) * 1.1 + 0.6
+
+
+def candidate_dirs(models_dir: str) -> list[Path]:
+    cands = []
+    if os.environ.get("LORA_TTS_MODEL_DIR"):
+        cands.append(Path(os.environ["LORA_TTS_MODEL_DIR"]))
+    base = Path(models_dir)
+    cands += [base, base.parent / SMALL_MODEL_NAME]
+    seen, out = set(), []
+    for c in cands:
+        if str(c).lower() not in seen and has_weights(c):
+            seen.add(str(c).lower())
+            out.append(c)
+    return out
+
+
+class FakeModel:
+    """A tone whose length follows the text, so the client path can be tested without a GPU."""
+
+    sr = FAKE_SR
+
+    def generate(self, text: str, voice: str) -> tuple[list[float], int]:
+        n = int(self.sr * min(2.0, 0.05 * max(1, len(text))))
+        return [0.2 * math.sin(2 * math.pi * 440 * i / self.sr) for i in range(n)], self.sr
+
+
+class RealModel:
+    def __init__(self, model, np) -> None:
+        self.model, self.np = model, np
+
+    def _speaker(self, voice: str) -> str:
+        try:
+            sup = self.model.get_supported_speakers()
+            names = list(sup.keys()) if isinstance(sup, dict) else list(sup)
+            lookup = {n.lower(): n for n in names}
+            if voice.lower() in lookup:
+                return lookup[voice.lower()]
+            if names:
+                return lookup.get("vivian", names[0])
+        except Exception:
+            pass
+        return "_".join(part.capitalize() for part in voice.split("_"))
+
+    def generate(self, text: str, voice: str) -> tuple[list[float], int]:
+        wavs, sr = self.model.generate_custom_voice(text=text, language="English", speaker=self._speaker(voice))
+        wav = wavs[0]
+        if hasattr(wav, "detach"):
+            wav = wav.detach().cpu().float().numpy()
+        return self.np.asarray(wav, dtype="float32").reshape(-1).tolist(), int(sr)
+
+
+def load_model(models_dir: str):
+    """Returns (model, dir, sr) or raises RuntimeError(reason, fix)."""
+    if os.environ.get("LORA_TTS_FAKE") == "1":
+        return FakeModel(), "fake", FAKE_SR
+    try:
+        import numpy as np
+        import torch
+    except Exception as exc:
+        raise RuntimeError(f"PyTorch is missing in the voice environment ({exc})|run scripts\\install_tts.ps1 again") from exc
+    if not torch.cuda.is_available():
+        raise RuntimeError(f"this PyTorch ({torch.__version__}) has no GPU support|run scripts\\install_tts.ps1 again, or try -Cuda cu126")
+    try:
+        from qwen_tts import Qwen3TTSModel
+    except Exception as exc:
+        raise RuntimeError(f"qwen-tts is missing in the voice environment ({exc})|run scripts\\install_tts.ps1 again") from exc
+    cands = candidate_dirs(models_dir)
+    if not cands:
+        raise RuntimeError(f"no Qwen3-TTS model files found in {models_dir}|download the model there (the smaller {SMALL_MODEL_NAME} also works)")
+    free_gb = torch.cuda.mem_get_info()[0] / 1e9
+    fitting = [c for c in cands if need_gb(c) <= free_gb]
+    if not fitting:
+        need = min(need_gb(c) for c in cands)
+        raise RuntimeError(f"not enough free GPU memory ({free_gb:.1f} GB free, {need:.1f} GB needed)|download the smaller {SMALL_MODEL_NAME} next to the other model or close other GPU programs")
+    chosen = max(fitting, key=weights_gb)
+    try:
+        try:
+            model = Qwen3TTSModel.from_pretrained(str(chosen), device_map="cuda:0", dtype=torch.bfloat16)
+        except TypeError:
+            model = Qwen3TTSModel.from_pretrained(str(chosen), device_map="cuda:0", torch_dtype=torch.bfloat16)
+    except Exception as exc:
+        torch.cuda.empty_cache()
+        oom = "out of memory" in str(exc).lower()
+        raise RuntimeError(
+            ("ran out of GPU memory while loading" if oom else f"loading failed ({type(exc).__name__}: {exc})")
+            + f"|download the smaller {SMALL_MODEL_NAME} or close other GPU programs"
+        ) from exc
+    return RealModel(model, np), str(chosen), 24000
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--models-dir", default=r"C:\Models\Qwen3-TTS-12Hz-1.7B-CustomVoice")
+    args = ap.parse_args()
+    try:
+        model, chosen, sr = load_model(args.models_dir)
+    except RuntimeError as exc:
+        reason, _, fix = str(exc).partition("|")
+        emit({"event": "error", "reason": reason, "fix": fix})
+        return 1
+    emit({"event": "ready", "dir": chosen, "sr": sr})
+    for line in sys.stdin:
+        try:
+            req = json.loads(line)
+        except Exception:
+            continue
+        if req.get("cmd") == "quit":
+            break
+        rid = req.get("id")
+        try:
+            samples, out_sr = model.generate(str(req.get("text", "")), str(req.get("voice", "vivian")))
+            emit({"id": rid, "ok": True, "path": write_wav(samples, out_sr), "sr": out_sr})
+        except Exception as exc:
+            emit({"id": rid, "ok": False, "error": f"{type(exc).__name__}: {exc}"})
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
